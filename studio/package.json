{
  "name": "@firekeep/studio",
  "version": "0.3.5",
  "private": true,
  "description": "Firekeep's runtime-neutral desktop console for local AI agents.",
  "productName": "Firekeep Studio",
  "author": "Firekeep",
  "main": "out/main/index.js",
  "type": "module",
  "license": "SEE LICENSE IN ../LICENSE",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "package": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "render:icon": "electron scripts/render-icon.cjs",
    "smoke:runtimes": "node scripts/live-smoke.mjs",
    "smoke:tasks": "node scripts/live-task-smoke.mjs",
    "smoke:package": "node scripts/package-smoke.mjs"
  },
  "build": {
    "appId": "ai.firekeep.studio",
    "asar": true,
    "icon": "resources/icon.png",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "Firekeep-Studio-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.developer-tools",
      "artifactName": "Firekeep-Studio-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": "AppImage",
      "category": "Development",
      "artifactName": "Firekeep-Studio-${version}-${arch}.${ext}"
    }
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.4.0",
    "dompurify": "^3.4.14",
    "lucide-react": "^1.33.0",
    "mermaid": "^11.17.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^29.0.0",
    "typescript": "^6.0.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
