# FirekeepBridge Configuration
# All variables are prefixed with NB_

# Redis (DB 3 to avoid FirekeepCortex collision)
NB_REDIS_URL=redis://localhost:6379/3

# MCP Server
NB_MCP_HOST=0.0.0.0
NB_MCP_PORT=8070

# FirekeepCortex Integration (for distillation)
NB_FIREKEEP_API_URL=http://localhost:8100
# Internal service key (FIREKEEP_INTERNAL_KEY minted by deploy/bootstrap-keys.sh;
# scopes memory:write, session:read, eval:read, eval:write — NOT admin)
NB_FIREKEEP_API_KEY=
NB_FIREKEEP_NAMESPACE=default

# Auth (shared ASGI validator — mirror the stack root .env values)
AUTH_ENABLED=false
AUTH_REDIS_URL=redis://localhost:6379/7

# Session Management
NB_SESSION_TTL_DAYS=7
NB_MAX_SESSIONS=100
NB_DEFAULT_AGENT_ID=default
