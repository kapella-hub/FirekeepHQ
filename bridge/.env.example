# FirekeepBridge Configuration
# All variables are prefixed with NB_

# Redis (DB 3 to avoid FirekeepCortex collision)
NB_REDIS_URL=redis://localhost:6379/3

# MCP Server
NB_MCP_HOST=0.0.0.0
NB_MCP_PORT=8070

# FirekeepCortex Integration (for distillation)
NB_FIREKEEP_API_URL=http://localhost:8100
# Bridge's OWN dedicated key (FIREKEEP_BRIDGE_KEY, minted by
# deploy/bootstrap-keys.sh; scopes memory:write, session:read, eval:read,
# eval:write, eval:grade — NOT admin). eval:grade is service-only and unique
# to this credential — do not substitute FIREKEEP_INTERNAL_KEY here.
NB_FIREKEEP_API_KEY=
NB_FIREKEEP_NAMESPACE=default

# Auth (shared ASGI validator — mirror the stack root .env values)
AUTH_ENABLED=false
AUTH_REDIS_URL=redis://localhost:6379/7

# Session Management
NB_SESSION_TTL_DAYS=7
NB_MAX_SESSIONS=100
NB_DEFAULT_AGENT_ID=default

# Crashed-session reaper — abandons sessions left "active" and silent past the
# idle threshold. A crashed agent never calls ctx_complete_session, so without
# this the session never reaches a terminal state and never reaches scoring.
# Note: abandoning does not distill; a reaped session's content is discarded.
NB_REAPER_ENABLED=true
NB_REAPER_IDLE_HOURS=72
NB_REAPER_INTERVAL_SECONDS=3600
# Per-pass ceiling — bounds the first pass on an old deployment; see reaper.py.
NB_REAPER_MAX_PER_PASS=500
