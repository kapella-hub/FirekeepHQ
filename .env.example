# =============================================================================
# Firekeep Configuration
# Copy to .env and edit: cp .env.example .env
# =============================================================================

# --- VPS ---
VPS_IP=YOUR_VPS_IP_HERE
# SSH account placed in loopback-server join codes. The client uses this only
# to establish the local port tunnel; it is not a Firekeep identity.
FIREKEEP_SSH_USER=root

# --- Which images to run ---
# Names the published server images (ghcr.io/kapella-hub/firekeep-*).
#
#   a release tag, e.g. v0.1.0  -> `bash install.sh --pull` fetches that release
#   dev (checkout default)      -> build from source, as a developer does
#
# The public bundle builder replaces `dev` with its release tag automatically.
# `dev` is NEVER published; a hand-built bundle must set a release tag before
# running `install.sh --pull`, or the installer stops and tells you to.
#
# `IMAGE_TAG` is shared by four different image repositories, so it cannot hold
# one digest that pins all four. Release workflows publish each version tag once
# and refuse to overwrite it on rerun; use the exact version supplied by the
# checksum-verified server bundle rather than a floating tag such as `latest`.
IMAGE_TAG=dev

# --- Network exposure ---
# Host interface every published APP port (8040-8100) binds to.
#
# 127.0.0.1 (default) = reachable only from the machine Firekeep runs on.
# 0.0.0.0             = reachable from every network this host is on, INCLUDING
#                       the public internet if this is a VPS.
#
# Set 0.0.0.0 only if you actually need remote clients, and understand this
# first: a host firewall does NOT contain a published Docker port. Docker
# programs its own iptables DOCKER chain, and that chain is evaluated BEFORE
# ufw's INPUT chain — so `ufw deny 8100` is simply never consulted for traffic
# Docker published, and `ufw status` will happily show your rules while the
# port answers the internet. This is not theoretical: it is how this stack's
# ports stayed open behind an active ufw and leaked 12 real secrets.
#
# If you need remote access, prefer, in order:
#   1. an SSH tunnel:  ssh -L 8100:127.0.0.1:8100 you@host   (leave this at 127.0.0.1)
#   2. a reverse proxy terminating TLS, with only the proxy published
#      (docker-compose.office.yml does exactly this with Caddy)
#   3. BIND_ADDR=0.0.0.0 plus a rule in Docker's own DOCKER-USER chain --
#      that chain IS consulted, unlike ufw's INPUT.
# Datastore ports (Neo4j, Qdrant, Redis, Ollama) ignore this var and stay on
# 127.0.0.1 always — widening app access must never widen database access.
BIND_ADDR=127.0.0.1

# --- CORS (cortex-api :8100 ONLY) ---
# This header said "used by all services". It was not: cortex/app/main.py is the
# only place that installs CORSMiddleware. sentinel and relay declared a
# CORS_ORIGINS setting and acted on it nowhere; bridge never declared one.
#
# Those dead settings are removed rather than wired up, because CORS on the MCP
# surfaces would protect nothing: CORS is a BROWSER restriction on cross-origin
# requests, and those ports are called by MCP clients and shims, not browsers.
# It is not access control either — anyone can curl any endpoint regardless of
# this value. Auth (AUTH_ENABLED) is what restricts access; this only affects a
# browser calling cortex-api directly from another origin. The bundled dashboard
# is same-origin through nginx, so this neither breaks nor fixes it.
CORS_ORIGINS=["http://YOUR_VPS_IP_HERE:8040"]

# --- Neo4j ---
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme
NEO4J_POOL_SIZE=50

# --- Qdrant ---
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=firekeep_memory

# --- Redis ---
REDIS_URL=redis://redis:6379/0
REDIS_STREAM_KEY=firekeep:event_stream
REDIS_BATCH_SIZE=50

# --- Celery ---
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- LLM ---
# LLM_MODEL and EMBEDDING_MODEL (below) are also what the ollama-pull service
# downloads at install (docker-compose.yml) — changing them here changes what
# gets pulled, not just what cortex asks Ollama for.
LLM_BASE_URL=http://ollama:11434/v1
# Cores ollama may use. Default 2.0 so the stack installs on a 2-core host —
# Docker REFUSES to create a container whose cpus exceeds the host core count,
# so too high a value fails `docker compose up` outright rather than degrading.
# Raise it on a bigger box: this is the main inference throughput knob.
OLLAMA_CPUS=2.0

LLM_MODEL=qwen3:4b
LLM_API_KEY=

# Chat-endpoint selection (cortex/app/llm.py). Ollama honours `think:false` on
# its NATIVE /api/chat and IGNORES it on /v1/chat/completions, so a thinking
# model generates its full reasoning on /v1 whatever you send. Measured on the
# VPS (ollama 0.32.4, qwen3:4b, 4 vCPU), same document both ways: 83.19s on /v1
# vs 4.00s native.
#   auto   — derive {root} from LLM_BASE_URL (must end in /v1), confirm with one
#            cached GET {root}/api/version, use native only if confirmed. A
#            vLLM/LiteLLM/OpenAI backend simply never confirms and is unaffected.
#   always — skip the probe. never — disable the native path entirely.
# Do NOT "fix" this by repointing LLM_BASE_URL at http://ollama:11434: three
# EMBEDDING call sites concatenate /embeddings onto that variable, so repointing
# it breaks every memory write.
LLM_NATIVE_CHAT=auto
LLM_NATIVE_PROBE_TTL_SECONDS=600.0
# Only for an ollama-native backend whose root this cannot derive. Normally empty.
LLM_NATIVE_BASE_URL=

# --- Embedding ---
# Models pulled at install and used at runtime. Changing EMBEDDING_MODEL also
# requires EMBEDDING_DIM to match, and a collection rebuild if memories exist.
# Small-machine profile: granite-embedding:30m with EMBEDDING_DIM=384.
EMBEDDING_MODEL=mxbai-embed-large
EMBEDDING_DIM=1024

# --- RAG Engine ---
BOOST_FACTOR=1.5
GRAPH_RELEVANCE_WEIGHT=0.4
CONTENT_HASH_LENGTH=32
# Opt in only with a fast generation backend; CPU Ollama otherwise waits for
# the synthesis timeout before returning the same raw recall results.
RECALL_SYNTHESIS_ENABLED=false
# Feedback-weighted recall (Knowledge Autopilot): thumbs accumulate per memory
# and nudge ranking through the same Beta-shrunk multiplier OWM uses. Weight is
# deliberately below OWM_WEIGHT — one reader's thumb is noisier evidence than a
# session outcome. See docs/guides/knowledge-autopilot.md.
FEEDBACK_ENABLED=true
FEEDBACK_WEIGHT=0.10
FEEDBACK_PRIOR_N=4

# --- Memory Decay ---
MEMORY_DECAY_HALF_LIFE_DAYS=90
DECAY_REFERENCE_DAYS=0
DECAY_PROCEDURAL_DAYS=180
DECAY_EPISODIC_DAYS=90
DECAY_TRANSIENT_DAYS=14

# Scheduled maintenance is archive-first. Purge is deliberately opt-in and,
# when enabled, applies only to GC-origin archives after the recovery window.
GC_ENABLED=true
GC_DRY_RUN=false
GC_SCHEDULE_HOURS=24
GC_ARCHIVE_GRACE_DAYS=90
GC_PURGE_ENABLED=false
EVICTION_THRESHOLD=1.5
SKILL_STALE_AFTER_DAYS=90

# --- Cortex API ---
APP_NAME=FirekeepCortex
DEBUG=false
RATE_LIMIT=60/minute

# --- Cortex MCP ---
FIREKEEP_API_URL=http://cortex-api:8000
MCP_HOST=0.0.0.0
MCP_PORT=8080
# Briefing aggregator upstreams (SP1b) — Cortex GET /briefing fans out to these.
# docker-compose falls back to the service DNS names; override only for a
# non-default topology.
RELAY_URL=http://relay:8050
SENTINEL_URL=http://sentinel:8060

# --- Owner hook access (optional) ---
# Personal API key attached as X-API-Key by scripts/*.sh hooks when the
# FIREKEEP_API_KEY shell env var is not set. Only meaningful when
# AUTH_ENABLED=true. Mint one: deploy/firekeep-admin keys create --agent <you>
# (cortex-mcp itself holds NO key post-SP1a — it forwards the caller's key.)
FIREKEEP_API_KEY=

# --- FirekeepBridge (NB_ prefix) ---
NB_REDIS_URL=redis://redis:6379/3
# Session reaper (Knowledge Autopilot): a session idle this long while still
# 'active' is a crash or a walk-away — it gets abandoned so it finally counts
# as a non-success in outcome scoring instead of vanishing. See
# docs/guides/knowledge-autopilot.md.
NB_REAPER_ENABLED=true
NB_REAPER_IDLE_HOURS=72
NB_REAPER_INTERVAL_SECONDS=3600
# Per-pass ceiling: the first pass on an old deployment drains its backlog at
# a bounded rate instead of one burst (each reap costs Redis round trips plus
# an eval trigger). Steady state never comes near it.
NB_REAPER_MAX_PER_PASS=500
NB_MCP_HOST=0.0.0.0
NB_MCP_PORT=8070
NB_FIREKEEP_API_URL=http://cortex-api:8000
# NB_FIREKEEP_API_KEY is wired from FIREKEEP_INTERNAL_KEY in docker-compose.yml — do not set here.
NB_FIREKEEP_NAMESPACE=default
NB_SESSION_TTL_DAYS=7
NB_MAX_SESSIONS=100
NB_DEFAULT_AGENT_ID=default

# --- FirekeepSentinel (NS_ prefix) ---
NS_REDIS_URL=redis://redis:6379/4
NS_MCP_HOST=0.0.0.0
NS_MCP_PORT=8060
NS_DOCKER_SOCKET=/var/run/docker.sock
# Container-state monitoring. OFF by default because it needs
# /var/run/docker.sock bind-mounted into Sentinel, and anything that can reach
# the Docker API can create a container with a host bind mount -- that is root
# on the host, not "read-only visibility". `:ro` on the mount does not help; it
# restricts the socket file, not the API. Turning this on ALSO requires
# restoring the mount in docker-compose.yml (see the note in the sentinel
# service). Prefer a read-only socket proxy exposing only GET /containers/json.
NS_DOCKER_COLLECTOR_ENABLED=false
NS_POLL_INTERVAL_DOCKER=30
NS_POLL_INTERVAL_GIT=60
NS_POLL_INTERVAL_FILES=30
NS_EVENT_RETENTION_HOURS=72
NS_EVENT_MAXLEN=10000
# Comma-separated paths to watch for git commits (mount points inside container)
NS_WATCH_PATHS=/watch
# Alerting: broadcast error/critical events to Relay
NS_RELAY_URL=http://relay:8050
NS_ALERT_SEVERITIES=error,critical
# Auto-indexing: trigger Symdex reindex on new git commits
NS_SYMDEX_URL=http://symdex:8090
NS_AUTO_INDEX_ENABLED=true
# Internal service key for outbound calls under office AUTH_ENABLED=true.
# Wired from FIREKEEP_INTERNAL_KEY in docker-compose.yml — do not set here.
# NS_FIREKEEP_INTERNAL_KEY=

# --- FirekeepRelay (NR_ prefix) ---
NR_REDIS_URL=redis://redis:6379/5
NR_MCP_HOST=0.0.0.0
NR_MCP_PORT=8050
NR_BULLETIN_TTL_HOURS=24
NR_CHANNEL_BACKLOG_SIZE=50
NR_CLAIM_TTL_MINUTES=30

# --- FirekeepSymdex (VPS HTTP mode) ---
FIREKEEP_SYMDEX_MODE=http
FIREKEEP_SYMDEX_HOST=0.0.0.0
FIREKEEP_SYMDEX_PORT=8090
FIREKEEP_CORTEX_URL=http://cortex-api:8000
# FIREKEEP_INTERNAL_KEY (defined below in the Auth block) is passed to symdex in
# docker-compose.yml and sent as X-API-Key on symdex->cortex calls under office AUTH.

# --- Replay Engine (RP_ prefix) ---
RP_ENABLED=true
RP_REDIS_URL=redis://redis:6379/6
RP_RETENTION_DAYS=30
RP_STREAM_MAXLEN=100000

# --- Auth (AUTH_ prefix) ---
# Stable deployment identity. install.sh/update.sh generate these once through
# deploy/bootstrap-keys.sh. Do not copy IDs between independent Firekeep servers,
# and do not rotate them after data has been written.
FIREKEEP_WORKSPACE_ID=
FIREKEEP_OWNER_MEMBER_ID=

# Enforces per-key X-API-Key authentication on EVERY MCP and REST surface
# (cortex-api, cortex-mcp, bridge, sentinel, relay). ON by default.
#
# Do not turn this off on anything reachable by another machine. With auth
# disabled every caller is anonymous, and an anonymous caller reaches
# GET /vault/secrets (your stored credentials, decrypted) and POST /auth/keys
# (mint yourself a key). That combination is how 12 real secrets left this
# stack's own VPS.
#
# You do NOT need to mint anything by hand first: install.sh and update.sh both
# run deploy/bootstrap-keys.sh before the app containers start, and it writes
# Redis DB 7 directly with redis-cli rather than POSTing to /auth/keys, so it
# cannot 401-lock itself. It fills in the two keys below and prints an admin
# key once. /health and /version stay unauthenticated, so health probes and
# `GET /version` support checks keep working. See docs/DEPLOYMENT-OFFICE.md.
#
# Add a device from Dashboard -> Devices, or from the server shell:
#   deploy/firekeep-admin invite --agent <device-name> --json
AUTH_ENABLED=true
AUTH_REDIS_URL=redis://redis:6379/7

# --- Single-use client enrollment (ENROLL_ prefix) ---
# The ticket is valid for 24 hours, but its spent/expired tombstone remains for
# seven days so retries get an explanation instead of an ambiguous 404.
ENROLL_TICKET_TTL_HOURS=24
ENROLL_TOMBSTONE_DAYS=7
# Device credential lifetime; 0 means never expires.
ENROLL_KEY_EXPIRES_DAYS=90
# Per-request limiter plus a Redis-global ceiling that remains effective when
# every request appears to come from one reverse proxy address.
ENROLL_RATE_LIMIT=10/minute
ENROLL_MAX_ATTEMPTS_PER_HOUR=60
# Internal service key (bridge distiller + workers). Minted by
# deploy/bootstrap-keys.sh; scopes: memory:write, session:read, eval:read, eval:write.
FIREKEEP_INTERNAL_KEY=
# Dashboard nginx key (admin-scoped; injected as X-API-Key on the dashboard's
# /api/* proxies). Minted by deploy/bootstrap-keys.sh. With auth on this is
# required, not optional — empty means every dashboard data tab 401s.
DASHBOARD_API_KEY=
# Relay -> Bridge outbound key, used only to persist decisions for NexusScope
# sessions with origin:"mcp". Minted by deploy/bootstrap-keys.sh, scoped to
# session:write and nothing else. Do NOT provision it with
# `firekeep-admin keys create`: that mints the full non-admin scope set, which
# would give a single internal write path read access to memory, replay and
# evals. Left empty, only those Relay->Bridge writes fail (401).
RELAY_INTERNAL_API_KEY=

# --- Office Deployment (optional; docker-compose.office.yml + deploy/Caddyfile) ---
# Hostname Caddy issues its internal-CA certificate for. Only read when running
# with the office compose override:
#   docker compose -f docker-compose.yml -f docker-compose.office.yml up -d
# See docs/DEPLOYMENT-OFFICE.md.
FIREKEEP_OFFICE_HOST=firekeep.office

# --- Evals ---
# Set to true to enable LLM-judged Tier 2 eval metrics (requires Ollama)
EVAL_LLM_ENABLED=false

# --- Knowledge Ingestion (docs -> skills orchestration, SP2 / SP2.1) ---
# POST /knowledge/ingest: corpus-ingest (sync, searchable now) -> enqueue async
# classify -> per-procedure skill drafts. Returns 202 {corpus_source, status, note}.
KNOWLEDGE_ENABLED=true
KNOWLEDGE_MAX_PROCEDURES=10
# Classify LLM-call timeout — now bounds the WORKER's classify call (no request/
# proxy timeout gates it). Sized for CPU Ollama (~150-200s on qwen3:4b); lower on GPU.
KNOWLEDGE_CLASSIFY_TIMEOUT_SECONDS=300
# Separately tunable budget for the NATIVE endpoint. Defaults to the SAME 300,
# because "native" does not imply "fast": the native path is faster only in that
# it disables THINKING, and the probe confirms ollama, not a thinking model. A
# non-thinking backend (the office deploy runs llama3.2:3b at ~56s per classify)
# is routed down the native path and gains nothing, so a reduction here costs it
# headroom for no speedup. A native classify measures ~6s, so lowering this only
# changes how fast a BROKEN call gives up. Lower it for a backend you measured.
KNOWLEDGE_CLASSIFY_NATIVE_TIMEOUT_SECONDS=300.0
# TTL (seconds) for the per-source ingest-status record surfaced in GET
# /knowledge/sources + the dashboard. 30d orphan safety-net.
KNOWLEDGE_STATUS_TTL_SECONDS=2592000

# --- URL Ingestion (SSRF-guarded crawler -> knowledge pipeline) ---
# POST /knowledge/ingest-url: crawl a URL (bounded depth/pages, same-site only,
# public-IP-only) and queue each fetched page through the knowledge pipeline.
KNOWLEDGE_URL_INGEST_ENABLED=true
# Hard ceiling on requested crawl depth (requests above this are clamped, not rejected).
KNOWLEDGE_CRAWL_MAX_DEPTH=2
# Hard ceiling on requested page count (requests above this are clamped, not rejected).
KNOWLEDGE_CRAWL_MAX_PAGES=25
# Per-request HTTP timeout (seconds) used by the crawler.
KNOWLEDGE_CRAWL_TIMEOUT_SECONDS=15
# Max bytes read per fetched page before truncation.
KNOWLEDGE_CRAWL_MAX_PAGE_BYTES=2000000

# --- Decision Board (SP4) ---
# POST /decision/synthesize: global recall -> deterministic evidence +
# knowledge_found, then a bounded best-effort LLM suggestion pass (degrades
# on timeout/error to a retrieval-only board).
DECISION_ENABLED=true
# Bounds the suggestion pass only; evidence/knowledge_found are returned
# regardless. 30 is both what the client already assumed and the most it can
# wait for: firekeep-decision hangs up at its synth timeout + 15s = 45s.
DECISION_SYNTH_TIMEOUT_SECONDS=30
DECISION_MAX_QUESTIONS=8

# --- Vault (VAULT_ prefix) ---
# Encrypted secret storage for infrastructure credentials and API tokens.
# Generate a key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VAULT_ENABLED=true
VAULT_KEY=
VAULT_REDIS_URL=redis://redis:6379/7

# --- Secret Scanning ---
SECRET_SCAN_ENABLED=true
SECRET_SCAN_MODE=warn

# --- Collectors (SP3) ---
# Living Knowledge Sync: scheduled collectors that pull external sources
# (wikis, etc.) into the corpus. Master switch + per-source enable flag;
# both must be true for a collector to run. Disabled/empty by default.
COLLECTORS_ENABLED=false
CONFLUENCE_COLLECTOR_ENABLED=false
CONFLUENCE_BASE_URL=
CONFLUENCE_SPACE_KEYS=
CONFLUENCE_LABEL=
# Vault key the collector reads the Confluence PAT from (see vault_store).
CONFLUENCE_PAT_VAULT_KEY=confluence_pat
# Confluence PAT — set here (or a K8s Secret) to skip Vault; else stored in Vault under CONFLUENCE_PAT_VAULT_KEY
CONFLUENCE_PAT=
CONFLUENCE_COLLECTOR_SCHEDULE_HOURS=24
# SETNX lock TTL (seconds) serializing collector runs.
COLLECTOR_LOCK_TTL_SECONDS=3600

# --- Living Procedures ---
# Makes a skill an OBSERVED procedure: an execution opens when a pre-edit action
# matches one of its step specs, a load-bearing step left undone raises an
# advisory, and a nightly pass reports per-step frequency (and, where the outcome
# signal permits, efficacy) as proposals a human approves. Opt-in: while false the
# gateway stage is a no-op, the pass self-gates, and /procedures is not mounted.
# See docs/superpowers/specs/2026-08-06-living-procedures-design.md
PROCEDURE_ENABLED=false
# Observe without warning — evidence-gathering mode for a first deployment.
PROCEDURE_WARN_ENABLED=true
# Executions required before an EFFICACY verdict is offered. Frequency reporting
# (Tier A) needs none; a proposal shown to a human needs a confidence floor that a
# ranking nudge does not.
PROCEDURE_MIN_EXECUTIONS=5
# Beta prior handed to compute_efficacy (mirrors OWM_PRIOR_N).
PROCEDURE_PRIOR_N=5
# How far efficacy(skipped) must fall below efficacy(observed) to call a step
# load-bearing — and, symmetrically, how close it must stay to call it dead.
PROCEDURE_EFFICACY_DELTA=0.15
# Evidence window (matches the 30d eval TTL — beyond it there is nothing to join to).
PROCEDURE_WINDOW_DAYS=30
# Execution-record TTL. Deliberately > the window so a window never reaches past
# its own data.
PROCEDURE_EXEC_TTL_DAYS=90
# Max observations one agent_id contributes per step (mirrors OWM_AGENT_CAP): one
# CI identity in a loop must not decide a team's procedure.
PROCEDURE_AGENT_CAP=5
# In-process matcher-index cache (seconds). Staleness this long on a warn is
# harmless; a Redis GET per customer Edit is not.
PROCEDURE_INDEX_CACHE_SECONDS=30
# Hard cap on step specs per skill — bounds the index and the pre-edit match loop.
PROCEDURE_MAX_SPECS=50
# Nightly hardening pass cadence (hours).
PROCEDURE_SCHEDULE_HOURS=24
