# =============================================================================
# Firekeep Configuration
# Copy to .env and edit: cp .env.example .env
# =============================================================================

# --- VPS ---
VPS_IP=YOUR_VPS_IP_HERE

# --- CORS (used by all services) ---
# SECURITY: Restrict to your dashboard URL in production.
# If not set, defaults to ["*"] (allows all origins).
CORS_ORIGINS=["http://YOUR_VPS_IP_HERE:8040"]

# --- Neo4j ---
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme
NEO4J_POOL_SIZE=50

# --- Qdrant ---
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=firekeep_memory

# --- Redis ---
REDIS_URL=redis://redis:6379/0
REDIS_STREAM_KEY=firekeep:event_stream
REDIS_BATCH_SIZE=50

# --- Celery ---
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- LLM ---
# LLM_MODEL and EMBEDDING_MODEL (below) are also what the ollama-pull service
# downloads at install (docker-compose.yml) — changing them here changes what
# gets pulled, not just what cortex asks Ollama for.
LLM_BASE_URL=http://ollama:11434/v1
LLM_MODEL=qwen3:4b
LLM_API_KEY=

# --- Embedding ---
# Models pulled at install and used at runtime. Changing EMBEDDING_MODEL also
# requires EMBEDDING_DIM to match, and a collection rebuild if memories exist.
# Small-machine profile: granite-embedding:30m with EMBEDDING_DIM=384.
EMBEDDING_MODEL=mxbai-embed-large
EMBEDDING_DIM=1024
# Install optional sentence-transformers/torch CPU fine-tuning deps on cortex-worker.
CORTEX_INSTALL_FINETUNE_DEPS=false

# --- RAG Engine ---
BOOST_FACTOR=1.5
GRAPH_RELEVANCE_WEIGHT=0.4
CONTENT_HASH_LENGTH=32

# --- Memory Decay ---
MEMORY_DECAY_HALF_LIFE_DAYS=90

# --- Cortex API ---
APP_NAME=FirekeepCortex
DEBUG=false
RATE_LIMIT=60/minute

# --- Cortex MCP ---
FIREKEEP_API_URL=http://cortex-api:8000
MCP_HOST=0.0.0.0
MCP_PORT=8080
# Briefing aggregator upstreams (SP1b) — Cortex GET /briefing fans out to these.
# docker-compose falls back to the service DNS names; override only for a
# non-default topology.
RELAY_URL=http://relay:8050
SENTINEL_URL=http://sentinel:8060

# --- Owner hook access (optional) ---
# Personal API key attached as X-API-Key by scripts/*.sh hooks when the
# FIREKEEP_API_KEY shell env var is not set. Only meaningful when
# AUTH_ENABLED=true. Mint one: deploy/firekeep-admin keys create --agent <you>
# (cortex-mcp itself holds NO key post-SP1a — it forwards the caller's key.)
FIREKEEP_API_KEY=

# --- FirekeepBridge (NB_ prefix) ---
NB_REDIS_URL=redis://redis:6379/3
NB_MCP_HOST=0.0.0.0
NB_MCP_PORT=8070
NB_FIREKEEP_API_URL=http://cortex-api:8000
# NB_FIREKEEP_API_KEY is wired from FIREKEEP_INTERNAL_KEY in docker-compose.yml — do not set here.
NB_FIREKEEP_NAMESPACE=default
NB_SESSION_TTL_DAYS=7
NB_MAX_SESSIONS=100
NB_DEFAULT_AGENT_ID=default

# --- FirekeepSentinel (NS_ prefix) ---
NS_REDIS_URL=redis://redis:6379/4
NS_MCP_HOST=0.0.0.0
NS_MCP_PORT=8060
NS_DOCKER_SOCKET=/var/run/docker.sock
NS_POLL_INTERVAL_DOCKER=30
NS_POLL_INTERVAL_GIT=60
NS_POLL_INTERVAL_FILES=30
NS_EVENT_RETENTION_HOURS=72
NS_EVENT_MAXLEN=10000
# Comma-separated paths to watch for git commits (mount points inside container)
NS_WATCH_PATHS=/watch
# Alerting: broadcast error/critical events to Relay
NS_RELAY_URL=http://relay:8050
NS_ALERT_SEVERITIES=error,critical
# Auto-indexing: trigger Symdex reindex on new git commits
NS_SYMDEX_URL=http://symdex:8090
NS_AUTO_INDEX_ENABLED=true
# Internal service key for outbound calls under office AUTH_ENABLED=true.
# Wired from FIREKEEP_INTERNAL_KEY in docker-compose.yml — do not set here.
# NS_FIREKEEP_INTERNAL_KEY=

# --- FirekeepRelay (NR_ prefix) ---
NR_REDIS_URL=redis://redis:6379/5
NR_MCP_HOST=0.0.0.0
NR_MCP_PORT=8050
NR_BULLETIN_TTL_HOURS=24
NR_CHANNEL_BACKLOG_SIZE=50
NR_CLAIM_TTL_MINUTES=30

# --- FirekeepSymdex (VPS HTTP mode) ---
FIREKEEP_SYMDEX_MODE=http
FIREKEEP_SYMDEX_HOST=0.0.0.0
FIREKEEP_SYMDEX_PORT=8090
FIREKEEP_CORTEX_URL=http://cortex-api:8000
# FIREKEEP_INTERNAL_KEY (defined below in the Auth block) is passed to symdex in
# docker-compose.yml and sent as X-API-Key on symdex->cortex calls under office AUTH.

# --- Replay Engine (RP_ prefix) ---
RP_ENABLED=true
RP_REDIS_URL=redis://redis:6379/6
RP_RETENTION_DAYS=30
RP_STREAM_MAXLEN=100000

# --- Auth (AUTH_ prefix) ---
# Set AUTH_ENABLED=true to enforce per-key X-API-Key authentication on EVERY
# MCP and REST surface (cortex-api, cortex-mcp, bridge, sentinel, relay).
# When false (default), all requests pass through without auth checks.
# BEFORE flipping to true, run: bash deploy/bootstrap-keys.sh (idempotent;
# mints the keys below + a one-time-printed admin key). Otherwise the first
# POST /auth/keys is itself 401-locked. See docs/DEPLOYMENT-OFFICE.md.
AUTH_ENABLED=false
AUTH_REDIS_URL=redis://redis:6379/7
# Internal service key (bridge distiller + workers). Minted by
# deploy/bootstrap-keys.sh; scopes: memory:write, session:read, eval:read, eval:write.
FIREKEEP_INTERNAL_KEY=
# Dashboard nginx key (admin-scoped; injected as X-API-Key on the dashboard's
# /api/* proxies). Minted by deploy/bootstrap-keys.sh.
DASHBOARD_API_KEY=

# --- Office Deployment (optional; docker-compose.office.yml + deploy/Caddyfile) ---
# Hostname Caddy issues its internal-CA certificate for. Only read when running
# with the office compose override:
#   docker compose -f docker-compose.yml -f docker-compose.office.yml up -d
# See docs/DEPLOYMENT-OFFICE.md.
FIREKEEP_OFFICE_HOST=firekeep.office

# --- Evals ---
# Set to true to enable LLM-judged Tier 2 eval metrics (requires Ollama)
EVAL_LLM_ENABLED=false

# --- Knowledge Ingestion (docs -> skills orchestration, SP2 / SP2.1) ---
# POST /knowledge/ingest: corpus-ingest (sync, searchable now) -> enqueue async
# classify -> per-procedure skill drafts. Returns 202 {corpus_source, status, note}.
KNOWLEDGE_ENABLED=true
KNOWLEDGE_MAX_PROCEDURES=10
# Classify LLM-call timeout — now bounds the WORKER's classify call (no request/
# proxy timeout gates it). Sized for CPU Ollama (~150-200s on qwen3:4b); lower on GPU.
KNOWLEDGE_CLASSIFY_TIMEOUT_SECONDS=300
# TTL (seconds) for the per-source ingest-status record surfaced in GET
# /knowledge/sources + the dashboard. 30d orphan safety-net.
KNOWLEDGE_STATUS_TTL_SECONDS=2592000

# --- URL Ingestion (SSRF-guarded crawler -> knowledge pipeline) ---
# POST /knowledge/ingest-url: crawl a URL (bounded depth/pages, same-site only,
# public-IP-only) and queue each fetched page through the knowledge pipeline.
KNOWLEDGE_URL_INGEST_ENABLED=true
# Hard ceiling on requested crawl depth (requests above this are clamped, not rejected).
KNOWLEDGE_CRAWL_MAX_DEPTH=2
# Hard ceiling on requested page count (requests above this are clamped, not rejected).
KNOWLEDGE_CRAWL_MAX_PAGES=25
# Per-request HTTP timeout (seconds) used by the crawler.
KNOWLEDGE_CRAWL_TIMEOUT_SECONDS=15
# Max bytes read per fetched page before truncation.
KNOWLEDGE_CRAWL_MAX_PAGE_BYTES=2000000

# --- Decision Board (SP4) ---
# POST /decision/synthesize: global recall -> deterministic evidence +
# knowledge_found, then a bounded best-effort LLM suggestion pass (degrades
# on timeout/error to a retrieval-only board).
DECISION_ENABLED=true
DECISION_SYNTH_TIMEOUT_SECONDS=20
DECISION_MAX_QUESTIONS=8

# --- Vault (VAULT_ prefix) ---
# Encrypted secret storage for infrastructure credentials and API tokens.
# Generate a key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VAULT_ENABLED=true
VAULT_KEY=
VAULT_REDIS_URL=redis://redis:6379/7

# --- Secret Scanning ---
SECRET_SCAN_ENABLED=true
SECRET_SCAN_MODE=warn

# --- Collectors (SP3) ---
# Living Knowledge Sync: scheduled collectors that pull external sources
# (wikis, etc.) into the corpus. Master switch + per-source enable flag;
# both must be true for a collector to run. Disabled/empty by default.
COLLECTORS_ENABLED=false
CONFLUENCE_COLLECTOR_ENABLED=false
CONFLUENCE_BASE_URL=
CONFLUENCE_SPACE_KEYS=
CONFLUENCE_LABEL=
# Vault key the collector reads the Confluence PAT from (see vault_store).
CONFLUENCE_PAT_VAULT_KEY=confluence_pat
# Confluence PAT — set here (or a K8s Secret) to skip Vault; else stored in Vault under CONFLUENCE_PAT_VAULT_KEY
CONFLUENCE_PAT=
CONFLUENCE_COLLECTOR_SCHEDULE_HOURS=24
# SETNX lock TTL (seconds) serializing collector runs.
COLLECTOR_LOCK_TTL_SECONDS=3600
