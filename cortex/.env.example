# =============================================================================
# FirekeepCortex Configuration
# Copy to .env and edit before running: cp .env.example .env
# =============================================================================

# --- API ---
APP_NAME=FirekeepCortex
DEBUG=false
AUTH_ENABLED=false     # true = per-key X-API-Key auth on the whole app (auth/asgi.py)
AUTH_REDIS_URL=redis://localhost:6379/7
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080"]
RATE_LIMIT=60/minute

# --- Neo4j ---
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme
NEO4J_POOL_SIZE=50

# --- Qdrant ---
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=firekeep_memory

# --- Redis ---
REDIS_URL=redis://redis:6379/0
REDIS_STREAM_KEY=firekeep:event_stream
REDIS_BATCH_SIZE=50

# --- Celery ---
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- LLM ---
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3
LLM_API_KEY=           # Required for OpenAI; optional for local Ollama

# --- Embedding ---
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768

# --- RAG Engine ---
BOOST_FACTOR=1.5
GRAPH_RELEVANCE_WEIGHT=0.4
CONTENT_HASH_LENGTH=32

# --- Re-ranking ---
RERANK_ENABLED=false
RERANK_CANDIDATES_MULTIPLIER=2

# --- Memory Decay ---
MEMORY_DECAY_HALF_LIFE_DAYS=90

# --- MCP Server ---
FIREKEEP_API_URL=http://api:8000
MCP_HOST=0.0.0.0
MCP_PORT=8080
