{
    # Internal CA for everything; no ACME, no outbound calls.
    # Root CA key lives in the caddy_data volume — back up like VAULT_KEY.
    local_certs
}

# Plain-HTTP visitors get bounced to HTTPS (any Host on :80).
http:// {
    redir https://{host}{uri} permanent
}

# `https://localhost` is a second site address so the compose healthcheck
# (wget https://localhost/health-caddy from inside the container) gets a
# matching certificate; the internal CA mints it automatically.
https://{$FIREKEEP_OFFICE_HOST:firekeep.office}, https://localhost {
    tls internal

    # Caddy-level liveness probe (used by the compose healthcheck).
    respond /health-caddy 200

    # ---- MCP surfaces (streamable HTTP) ----
    # Rewrite to EXACTLY /mcp (no trailing slash -> no redirect escapes
    # the prefix). NOTE: no `encode` directive on these routes (SSE +
    # compression edge cases) and no read timeouts (long streams must
    # survive). Caddy auto-flushes text/event-stream responses.
    #
    # /mcp/symdex is DELIBERATELY NOT ROUTED: office symdex runs
    # stdio-local (SP1b); the HTTP surface has no office consumer and
    # no auth middleware, so exposing it would be a key-free bypass.
    handle /mcp/cortex* {
        rewrite * /mcp
        reverse_proxy cortex-mcp:8080
    }
    handle /mcp/bridge* {
        rewrite * /mcp
        reverse_proxy bridge:8070
    }
    handle /mcp/sentinel* {
        rewrite * /mcp
        reverse_proxy sentinel:8060
    }
    handle /mcp/relay* {
        rewrite * /mcp
        reverse_proxy relay:8050
    }

    # ---- REST surfaces (prefix-strip, mirrors dashboard nginx convention) ----

    # Cortex mounts a /dashboard router (cortex/app/dashboard.py) that now
    # serves only JSON under /dashboard/api/* — every route auth-gated at the
    # middleware layer, none on the auth skip list. Cortex's own legacy HTML
    # dashboard, whose keyless shell paths were the last /dashboard skip-list
    # entries, was removed 2026-10-01 (docs/THREAT-MODEL.md §5.2). Before the
    # 2026-07-26 fix a /dashboard PREFIX skip let GET /dashboard/api/memories
    # return real memory content to any unauthenticated caller; this Caddy
    # block was the first fix and is now REDUNDANT defense-in-depth — keep it
    # anyway: this office front is public, and a second layer that fails
    # closed even if the auth wiring ever regresses is worth the two lines.
    # This handle matcher (/api/cortex/dashboard*) is more specific than the
    # /api/cortex/* proxy below, and Caddy auto-sorts `handle` blocks by
    # matcher specificity regardless of file order, so it always wins and
    # short-circuits to 404 here — verified via `caddy adapt` (see
    # deploy/README or task history). Do NOT remove this block to "simplify"
    # routing — that drops the second layer through the public front. The
    # unified dashboard (dashboard/ nginx SPA on :8040) is unaffected: it is
    # never proxied through this front's /api/cortex/*; nginx proxies it to
    # cortex directly and injects DASHBOARD_API_KEY on every call
    # (dashboard/nginx.conf.template).
    handle /api/cortex/dashboard* {
        respond 404
    }

    handle_path /api/cortex/* {
        reverse_proxy cortex-api:8000
    }
    handle_path /api/bridge/* {
        reverse_proxy bridge:8070
    }
    handle_path /api/sentinel/* {
        reverse_proxy sentinel:8060
    }
    handle_path /api/relay/* {
        reverse_proxy relay:8050
    }

    # A2A discovery (served by relay at a well-known root path; pre-auth
    # by design — it is on the auth middleware skip list).
    handle /.well-known/agent.json {
        reverse_proxy relay:8050
    }

    # Everything else (including the dashboard, which is NOT exposed
    # through the office front — it stays on its own 127.0.0.1 binding
    # behind nginx basic-auth) -> 404.
    handle {
        respond 404
    }
}
