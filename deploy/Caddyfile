{
    # Internal CA for everything; no ACME, no outbound calls.
    # Root CA key lives in the caddy_data volume — back up like VAULT_KEY.
    local_certs
}

# Plain-HTTP visitors get bounced to HTTPS (any Host on :80).
http:// {
    redir https://{host}{uri} permanent
}

# `https://localhost` is a second site address so the compose healthcheck
# (wget https://localhost/health-caddy from inside the container) gets a
# matching certificate; the internal CA mints it automatically.
https://{$FIREKEEP_OFFICE_HOST:firekeep.office}, https://localhost {
    tls internal

    # Caddy-level liveness probe (used by the compose healthcheck).
    respond /health-caddy 200

    # ---- MCP surfaces (streamable HTTP) ----
    # Rewrite to EXACTLY /mcp (no trailing slash -> no redirect escapes
    # the prefix). NOTE: no `encode` directive on these routes (SSE +
    # compression edge cases) and no read timeouts (long streams must
    # survive). Caddy auto-flushes text/event-stream responses.
    #
    # /mcp/symdex is DELIBERATELY NOT ROUTED: office symdex runs
    # stdio-local (SP1b); the HTTP surface has no office consumer and
    # no auth middleware, so exposing it would be a key-free bypass.
    handle /mcp/cortex* {
        rewrite * /mcp
        reverse_proxy cortex-mcp:8080
    }
    handle /mcp/bridge* {
        rewrite * /mcp
        reverse_proxy bridge:8070
    }
    handle /mcp/sentinel* {
        rewrite * /mcp
        reverse_proxy sentinel:8060
    }
    handle /mcp/relay* {
        rewrite * /mcp
        reverse_proxy relay:8050
    }

    # ---- REST surfaces (prefix-strip, mirrors dashboard nginx convention) ----

    # Cortex's EMBEDDED dashboard (mounted by cortex-api itself at
    # /dashboard — see cortex/app/dashboard.py) is a browser SPA that
    # cannot attach X-API-Key, so auth/asgi.py's FirekeepKeyAuthMiddleware
    # exempts only the literal shell paths GET /dashboard and /dashboard/
    # (app/main.py's AUTH_SKIP_EXACT_PATHS — an EXACT match, not a prefix,
    # as of 2026-07-26). Every /dashboard/api/* route — including the
    # destructive DELETE /dashboard/api/dlq/clear — is now auth-gated at
    # the middleware layer, closing the hole where GET /dashboard/api/memories
    # returned real memory content to any unauthenticated caller. This
    # Caddy block is therefore REDUNDANT defense-in-depth, not the sole
    # fix it once was — keep it anyway: this office front is public, and a
    # second layer that fails closed even if the auth wiring ever regresses
    # is worth the two lines. This handle matcher (/api/cortex/dashboard*)
    # is more specific than the /api/cortex/* proxy below, and Caddy
    # auto-sorts `handle` blocks by matcher specificity regardless of file
    # order, so it always wins and short-circuits to 404 here — verified
    # via `caddy adapt` (see deploy/README or task history). The embedded
    # dashboard stays reachable for the owner via SSH/localhost on the
    # cortex-api port, which the office compose override
    # (docker-compose.office.yml) rebinds to 127.0.0.1:8100 — and even
    # there, its /api/* calls now need a valid X-API-Key. Do NOT remove
    # this block to "simplify" routing — that drops the second layer
    # through the public front. The real unified dashboard (dashboard/
    # nginx SPA on :8040) is unaffected: it lives at a different path
    # entirely and is never proxied through /api/cortex/*, and it already
    # carries a valid key on every /api/cortex/* call via nginx's
    # DASHBOARD_API_KEY injection (dashboard/nginx.conf.template).
    handle /api/cortex/dashboard* {
        respond 404
    }

    handle_path /api/cortex/* {
        reverse_proxy cortex-api:8000
    }
    handle_path /api/bridge/* {
        reverse_proxy bridge:8070
    }
    handle_path /api/sentinel/* {
        reverse_proxy sentinel:8060
    }
    handle_path /api/relay/* {
        reverse_proxy relay:8050
    }

    # A2A discovery (served by relay at a well-known root path; pre-auth
    # by design — it is on the auth middleware skip list).
    handle /.well-known/agent.json {
        reverse_proxy relay:8050
    }

    # Everything else (including the dashboard, which is NOT exposed
    # through the office front — it stays on its own 127.0.0.1 binding
    # behind nginx basic-auth) -> 404.
    handle {
        respond 404
    }
}
