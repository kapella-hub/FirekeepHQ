#!/usr/bin/env bash
set -euo pipefail

# Server-local device enrollment and key administration.
#
#   firekeep-admin invite [--agent NAME] [--expires-days N] [--json]
#   firekeep-admin keys create --agent NAME [--expires-days N]
#   firekeep-admin keys revoke CREDENTIAL_ID
#   firekeep-admin members list|remove MEMBER_ID|restore MEMBER_ID
#   firekeep-admin memory revert --credential ID --since ISO [--until ISO] [--apply]
#   firekeep-admin memory revert-undo --revert-id ID [--apply]

# eval:grade, memory:write:delegated, session:read:workspace and
# relay:write:service are deliberately ABSENT here: they are SERVICE-ONLY
# (auth/keys.py SERVICE_ONLY_SCOPES), minted exclusively by
# deploy/bootstrap-keys.sh onto dedicated service credentials
# (FIREKEEP_BRIDGE_KEY, FIREKEEP_INTERNAL_KEY), and rejected outright by
# create_key if listed. This literal must equal
# auth.keys.ENROLLABLE_SCOPES exactly (auth/tests/test_enrollable_scopes.py
# parity check).
NON_ADMIN_SCOPES='["dex:docdex", "dex:maildex", "eval:read", "eval:write", "memory:read", "memory:write", "relay:read", "relay:write", "replay:read", "session:read", "session:write", "vault:read"]'
# Never minted here; listed so `keys audit` recognises them as known scopes.
# Must equal auth.keys.SERVICE_ONLY_SCOPES (deploy/tests/test_firekeep_admin.sh).
SERVICE_ONLY_SCOPES='["eval:grade", "memory:write:delegated", "relay:write:service", "session:read:workspace"]'
API_URL="${FIREKEEP_API_URL:-http://localhost:8100}"
ENV_FILE="${ENV_FILE:-.env}"
IFS=' ' read -r -a REDIS <<< "${BOOTSTRAP_REDIS_CMD:-docker compose exec -T redis redis-cli -n 7}"

# Every Redis call goes through rcli, with stdin closed. In production REDIS is
# `docker compose exec -T redis redis-cli -n 7`, and docker compose exec reads
# stdin even with -T: inside `while read ...; done < <(scan)` the first call in
# the loop body swallowed the rest of the scan, so the loop stopped after one
# record (`keys audit` on a live box reported 1 credential of 15, 2026-10-04).
# Never call "${REDIS[@]}" directly.
rcli() { "${REDIS[@]}" "$@" < /dev/null; }

usage() {
    cat >&2 <<'EOF'
Usage:
  firekeep-admin invite [--agent NAME] [--expires-days N] [--json]
      [--local] [--host HOST | --base-url URL] [--ssh-target USER@HOST]
      [--ca-file PATH | --ca os] [--insecure-http] [--dist-base URL]
      [--member MEMBER_ID]

  --local   a code for THIS machine, redeemed on THIS machine over loopback.
            Used by `firekeep init` to enrol the server box against itself.
  --member  the code's credential belongs to this (active) member instead of
            the deployment owner — e.g. after `members restore`.
  firekeep-admin keys create --agent NAME [--expires-days N]
  firekeep-admin keys revoke CREDENTIAL_ID
  firekeep-admin keys audit
      READ-ONLY: classify every stored credential against the 2026-10-04
      validation rules (attribution, member status, scope document, expiry).
  firekeep-admin members list
  firekeep-admin members remove MEMBER_ID
      Mark the member removed (row kept for attribution), delete every
      credential naming them, cancel their unredeemed join codes. Their
      member-private data is kept, unread by any member. The deployment
      owner can never be removed. Idempotent.
  firekeep-admin members restore MEMBER_ID
      Reactivate a removed member (no credential is issued), then:
      firekeep-admin invite --member MEMBER_ID
  firekeep-admin memory revert --credential CREDENTIAL_ID --since ISO8601
      [--until ISO8601] [--apply]
      Archive the memories one credential wrote in [since, until) (until
      defaults to now), in the admin key's workspace. DRY RUN unless --apply:
      prints the count and a sample. Times need a UTC offset, e.g.
      2026-10-05T10:00:00+00:00. Revoke the key FIRST (keys revoke), then
      dry-run, then --apply. Reversible: the output names a revert_id.
  firekeep-admin memory revert-undo --revert-id REVERT_ID [--apply]
      Restore every memory that revert archived (dry run unless --apply).
      Both call the Cortex REST API with FIREKEEP_ADMIN_KEY, else the .env
      DASHBOARD_API_KEY (FIREKEEP_API_URL, default http://localhost:8100).
EOF
    exit 1
}

env_get() {
    { grep -E "^$1=" "$ENV_FILE" 2>/dev/null || true; } | head -n1 | cut -d= -f2-
}

redis_available() {
    rcli PING 2>/dev/null | grep -q PONG
}

valid_id() { [[ "$1" =~ ^[0-9a-f]{1,64}$ ]]; }
valid_agent() { [[ "$1" =~ ^[A-Za-z0-9_.-]{1,64}$ ]]; }
valid_member() { [[ "$1" =~ ^[A-Za-z0-9_.-]{1,128}$ ]]; }

keys_create() {
    local agent="" expires_days=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --agent) agent="${2:?--agent requires a value}"; shift 2 ;;
            --expires-days) expires_days="${2:?--expires-days requires a value}"; shift 2 ;;
            *) echo "Unknown argument: $1" >&2; usage ;;
        esac
    done
    [ -n "$agent" ] && valid_agent "$agent" || usage
    if [ -n "$expires_days" ] && ! [[ "$expires_days" =~ ^([0-9]|[1-9][0-9]{1,2})$ ]]; then
        echo "ERROR: --expires-days must be an integer from 0 to 999" >&2
        exit 1
    fi

    local body="{\"agent_id\": \"${agent}\", \"scopes\": ${NON_ADMIN_SCOPES}"
    [ -n "$expires_days" ] && body="${body}, \"expires_days\": ${expires_days}"
    body="${body}}"
    if [ "${FIREKEEP_ADMIN_DRY_RUN:-0}" = "1" ]; then
        echo "POST ${API_URL}/auth/keys"
        echo "$body"
        return
    fi

    if [ -z "${FIREKEEP_ADMIN_KEY:-}" ] && redis_available; then
        local key hash now credential_id workspace_id member_id expires_at="" ttl=""
        key="nxs_$(openssl rand -hex 24)"
        hash="$(printf '%s' "$key" | sha256sum | awk '{print $1}')"
        credential_id="$(openssl rand -hex 8)"
        workspace_id="$(env_get FIREKEEP_WORKSPACE_ID)"
        member_id="$(env_get FIREKEEP_OWNER_MEMBER_ID)"
        if [ -z "$workspace_id" ] || [ -z "$member_id" ]; then
            echo "ERROR: FIREKEEP_WORKSPACE_ID and FIREKEEP_OWNER_MEMBER_ID are missing; run deploy/bootstrap-keys.sh" >&2
            exit 1
        fi
        now="$(date -u +"%Y-%m-%dT%H:%M:%S+00:00")"
        rcli HSET "auth:key:${hash}" \
            workspace_id "$workspace_id" member_id "$member_id" \
            device_id "$agent" credential_id "$credential_id" \
            key_id "$credential_id" scopes "$NON_ADMIN_SCOPES" created_at "$now" >/dev/null
        if [ -n "$expires_days" ]; then
            expires_at="$(date -u -d "+${expires_days} days" +"%Y-%m-%dT%H:%M:%S+00:00")"
            ttl="$((expires_days * 86400))"
            rcli HSET "auth:key:${hash}" expires_at "$expires_at" >/dev/null
            rcli EXPIRE "auth:key:${hash}" "$ttl" >/dev/null
        fi
        rcli SET "auth:cred:${credential_id}" "$hash" >/dev/null
        [ -n "$ttl" ] && rcli EXPIRE "auth:cred:${credential_id}" "$ttl" >/dev/null
        rcli ZADD auth:key_index "$(date -u +%s)" "$credential_id" >/dev/null
        printf '{"agent_id":"%s","credential_id":"%s","key_id":"%s","api_key":"%s"}\n' \
            "$agent" "$credential_id" "$credential_id" "$key"
        echo "Minted locally against Redis DB 7; the api_key is shown only once." >&2
        return
    fi

    if [ -z "${FIREKEEP_ADMIN_KEY:-}" ]; then
        if [ ! -t 0 ]; then
            echo "ERROR: no FIREKEEP_ADMIN_KEY, no TTY to prompt, and Redis DB 7 is unreachable." >&2
            exit 1
        fi
        read -rsp "Admin API key: " FIREKEEP_ADMIN_KEY
        echo
    fi
    curl -sf -X POST "${API_URL}/auth/keys" \
        -H "Content-Type: application/json" \
        -H "X-API-Key: ${FIREKEEP_ADMIN_KEY}" \
        -d "$body" || { echo "ERROR: key creation failed." >&2; exit 1; }
    echo
}

keys_revoke() {
    [ $# -eq 1 ] || usage
    local credential_id="$1" hash="" redis_key="" stored_id="" count=0 match=""
    valid_id "$credential_id" || { echo "ERROR: invalid credential id" >&2; exit 1; }
    if [ "${FIREKEEP_ADMIN_DRY_RUN:-0}" = "1" ]; then
        echo "REVOKE ${credential_id} (local Redis DB 7)"
        return
    fi
    redis_available || { echo "ERROR: Redis DB 7 is unreachable" >&2; exit 1; }

    hash="$(rcli GET "auth:cred:${credential_id}")"
    if [ -n "$hash" ]; then
        redis_key="auth:key:${hash}"
        stored_id="$(rcli HGET "$redis_key" credential_id)"
        [ -n "$stored_id" ] || stored_id="$(rcli HGET "$redis_key" key_id)"
        if [ "$stored_id" != "$credential_id" ]; then
            echo "ERROR: auth:cred:${credential_id} points to a mismatched record; refusing" >&2
            exit 1
        fi
        match="$redis_key"
        count=1
    else
        while IFS= read -r candidate; do
            [ -n "$candidate" ] || continue
            stored_id="$(rcli HGET "$candidate" credential_id)"
            [ -n "$stored_id" ] || stored_id="$(rcli HGET "$candidate" key_id)"
            if [ "$stored_id" = "$credential_id" ]; then
                match="$candidate"
                count=$((count + 1))
            fi
        done < <(rcli --scan --pattern "auth:key:${credential_id}*")
    fi
    if [ "$count" -gt 1 ]; then
        echo "ERROR: credential id is ambiguous across ${count} legacy records; nothing revoked" >&2
        exit 1
    fi
    if [ "$count" -eq 0 ]; then
        printf '{"status":"not_found","credential_id":"%s"}\n' "$credential_id"
        return
    fi
    rcli DEL "$match" "auth:cred:${credential_id}" >/dev/null
    rcli ZREM auth:key_index "$credential_id" >/dev/null
    printf '{"status":"revoked","credential_id":"%s"}\n' "$credential_id"
}

# Read-only classification of every auth:key:* record against what
# auth/keys.py validate_key accepts since 2026-10-04 — run it BEFORE an upgrade
# to see which credentials the stricter validator would refuse, and after one
# to confirm nothing is left behind. Issues only GET/HGET/ZSCORE/SCAN: it
# never writes. Verdicts:
#   ok            authenticates as the member shown
#   unattributed  no member/workspace/credential id. Used to be the owner's
#                 silently; deploy/bootstrap-keys.sh (and cortex-api on every
#                 boot) now stamp the deployment owner explicitly, so it keeps
#                 working after the upgrade
#   refused: ...  will NOT authenticate after the upgrade (another workspace,
#                 an inactive/missing member, a malformed scope document, an
#                 unreadable expiry) — revoke and re-issue it
#   expired       already does not authenticate
keys_audit() {
    [ $# -eq 0 ] || usage
    if [ "${FIREKEEP_ADMIN_DRY_RUN:-0}" = "1" ]; then
        echo "AUDIT (local Redis DB 7, read-only)"
        return
    fi
    redis_available || { echo "ERROR: Redis DB 7 is unreachable" >&2; exit 1; }

    local workspace owner known now
    workspace="$(env_get FIREKEEP_WORKSPACE_ID)"
    [ -n "$workspace" ] || workspace="$(rcli HGET auth:workspace:current workspace_id)"
    owner="$(env_get FIREKEEP_OWNER_MEMBER_ID)"
    [ -n "$owner" ] || owner="$(rcli HGET auth:workspace:current owner_member_id)"
    known=" $(printf '%s %s' "$NON_ADMIN_SCOPES" "$SERVICE_ONLY_SCOPES" | grep -oE '"[^"]*"' | tr -d '"' | tr '\n' ' ') admin * "
    now="$(date -u +%s)"
    local doc_re='^\[[[:space:]]*("[^"]*"[[:space:]]*(,[[:space:]]*"[^"]*"[[:space:]]*)*)?\]$'
    local total=0 n_ok=0 n_attr=0 n_refused=0 n_expired=0
    local key hash wid mid cid kid scopes exp device id verdict unknown s es status mws mmid notes

    printf '%-16s  %-20s  %-40s  %s\n' CREDENTIAL DEVICE MEMBER VERDICT
    while IFS= read -r key; do
        [[ "$key" =~ ^auth:key:[0-9a-f]{64}$ ]] || continue
        hash="${key#auth:key:}"
        wid="$(rcli HGET "$key" workspace_id)"
        mid="$(rcli HGET "$key" member_id)"
        cid="$(rcli HGET "$key" credential_id)"
        kid="$(rcli HGET "$key" key_id)"
        scopes="$(rcli HGET "$key" scopes)"
        exp="$(rcli HGET "$key" expires_at)"
        device="$(rcli HGET "$key" device_id)"
        [ -n "$device" ] || device="$(rcli HGET "$key" agent_id)"
        id="${cid:-${kid:-${hash:0:16}}}"
        [ -n "$scopes" ] || scopes='[]'
        verdict="ok"; notes=""; total=$((total + 1))

        if [ -n "$exp" ]; then
            if ! [[ "$exp" =~ (Z|[+-][0-9]{2}:?[0-9]{2})$ ]] || ! es="$(date -u -d "$exp" +%s 2>/dev/null)"; then
                verdict="refused: unreadable expiry '${exp}'"
            elif [ "$es" -lt "$now" ]; then
                verdict="expired"
            fi
        fi
        if [ "$verdict" = "ok" ] && ! [[ "$scopes" =~ $doc_re ]]; then
            verdict="refused: malformed scope document"
        fi
        if [ "$verdict" = "ok" ]; then
            unknown=""
            while IFS= read -r s; do
                [ -n "$s" ] || continue
                case "$known" in *" $s "*) ;; *) unknown="${unknown:+$unknown,}$s" ;; esac
            done < <(printf '%s' "$scopes" | grep -oE '"[^"]*"' | tr -d '"' || true)
            [ -z "$unknown" ] || notes="${notes} drops unknown scope(s) ${unknown};"
            if [ -z "$wid" ] || [ -z "$mid" ] || [ -z "$cid" ]; then
                verdict="unattributed: will be assigned to owner ${owner:-?}"
            elif [ -n "$workspace" ] && [ "$wid" != "$workspace" ]; then
                verdict="refused: belongs to workspace ${wid}"
            else
                status="$(rcli HGET "auth:member:${mid}" status)"
                mws="$(rcli HGET "auth:member:${mid}" workspace_id)"
                mmid="$(rcli HGET "auth:member:${mid}" member_id)"
                if [ "$status" != "active" ] || [ "$mws" != "$wid" ] || [ "$mmid" != "$mid" ]; then
                    verdict="refused: member ${mid} is not active (row status '${status:-missing}')"
                fi
            fi
        fi
        [ -n "$(rcli ZSCORE auth:key_index "$id")" ] || notes="${notes} not in auth:key_index;"
        [ "$(rcli GET "auth:cred:${id}")" = "$hash" ] || notes="${notes} no auth:cred mapping;"

        case "$verdict" in
            ok) n_ok=$((n_ok + 1)) ;;
            unattributed*) n_attr=$((n_attr + 1)) ;;
            expired) n_expired=$((n_expired + 1)) ;;
            *) n_refused=$((n_refused + 1)) ;;
        esac
        printf '%-16s  %-20s  %-40s  %s%s\n' "$id" "${device:-?}" "${mid:--}" "$verdict" "${notes:+ |$notes}"
    done < <(rcli --scan --pattern 'auth:key:*')

    echo ""
    echo "${total} credential(s): ${n_ok} ok, ${n_attr} unattributed, ${n_refused} refused, ${n_expired} expired"
    if [ "$n_attr" -gt 0 ]; then
        echo "Unattributed credentials keep working: bash deploy/bootstrap-keys.sh (or a cortex-api restart) assigns them to the owner, logged."
    fi
    if [ "$n_refused" -gt 0 ]; then
        echo "Refused credentials will NOT authenticate after this upgrade. Revoke and re-issue them: deploy/firekeep-admin keys revoke <CREDENTIAL>"
    fi
}

invite() {
    local agent="" expires_days="" output_json=0 host="" base_url="" ssh_target=""
    local ca_file="" ca_mode="" insecure=0 local_only=0 member=""
    local dist_base="${FIREKEEP_DIST_BASE:-https://firekeep.ai}"
    while [ $# -gt 0 ]; do
        case "$1" in
            --local) local_only=1; shift ;;
            --agent) agent="${2:?--agent requires a value}"; shift 2 ;;
            --expires-days) expires_days="${2:?--expires-days requires a value}"; shift 2 ;;
            --host) host="${2:?--host requires a value}"; shift 2 ;;
            --base-url) base_url="${2:?--base-url requires a value}"; shift 2 ;;
            --ssh-target) ssh_target="${2:?--ssh-target requires a value}"; shift 2 ;;
            --ca-file) ca_file="${2:?--ca-file requires a value}"; shift 2 ;;
            --ca) ca_mode="${2:?--ca requires a value}"; shift 2 ;;
            --dist-base) dist_base="${2:?--dist-base requires a value}"; shift 2 ;;
            --insecure-http) insecure=1; shift ;;
            --member) member="${2:?--member requires a value}"; shift 2 ;;
            --json) output_json=1; shift ;;
            *) echo "Unknown argument: $1" >&2; usage ;;
        esac
    done
    [ -z "$agent" ] || valid_agent "$agent" || usage
    [ -z "$member" ] || valid_member "$member" || { echo "ERROR: invalid member id" >&2; exit 1; }
    if [ "$(env_get AUTH_ENABLED)" = "false" ]; then
        echo "ERROR: this server enforces no authentication (AUTH_ENABLED=false), so there is no key to issue." >&2
        exit 1
    fi

    local bind_addr vps_ip transport kind server_user ca_pem_b64=""
    bind_addr="$(env_get BIND_ADDR)"; bind_addr="${bind_addr:-127.0.0.1}"
    vps_ip="$(env_get VPS_IP)"
    server_user="$(env_get FIREKEEP_SSH_USER)"
    server_user="${server_user:-${SUDO_USER:-${USER:-root}}}"
    if [ "$local_only" -eq 1 ]; then
        # A code for THIS machine, consumed on THIS machine.
        #
        # Without it, the loopback branch below mints a TUNNEL code -- correct
        # for a laptop reaching a loopback-bound server, absurd for the server
        # box enrolling itself, which would be asked to SSH to its own address
        # to reach a port already on its own loopback interface. That absurdity
        # is why the box that had just finished building the server could not
        # talk to it, and why the install's closing advice ("Dashboard ->
        # Devices") pointed at a UI bound to an interface the user could not
        # reach from where they were standing.
        #
        # transport=http is safe here in the only sense that matters: the
        # request never leaves the loopback interface, so there is no network
        # path on which to intercept it. This is NOT the same claim as
        # --insecure-http over a real network, which stays gated below.
        transport="http"; kind="ports"; host="127.0.0.1"
    elif [ -n "$ca_file" ] || [ "$ca_mode" = "os" ]; then
        transport="tls"; kind="$([ -n "$base_url" ] && echo paths || echo ports)"
        [ -n "$host" ] || host="$vps_ip"
    elif [[ "$bind_addr" = "127.0.0.1" || "$bind_addr" = "localhost" || "$bind_addr" = "::1" ]]; then
        transport="tunnel"; kind="ports"; host="127.0.0.1"
        if [ -z "$ssh_target" ]; then
            [ -n "$vps_ip" ] || { echo "ERROR: VPS_IP or --ssh-target is required for a tunnel join code" >&2; exit 1; }
            ssh_target="${server_user}@${vps_ip}"
        fi
    else
        [ "$insecure" -eq 1 ] || {
            echo "ERROR: network-reachable plain HTTP requires --insecure-http" >&2; exit 1;
        }
        transport="http"; kind="$([ -n "$base_url" ] && echo paths || echo ports)"
        [ -n "$host" ] || host="$vps_ip"
        echo "WARNING: join code and later X-API-Key requests use cleartext HTTP." >&2
    fi

    if [ -n "$ca_file" ]; then
        [ -r "$ca_file" ] || { echo "ERROR: cannot read CA file: $ca_file" >&2; exit 1; }
        # The mint helper runs inside cortex-api, where a host path is not
        # necessarily mounted.  Carry the public certificate bytes explicitly.
        ca_pem_b64="$(base64 < "$ca_file" | tr -d '\r\n')"
    fi

    local cmd=(docker compose exec -T cortex-api python -m app.enroll.mint
        --transport "$transport" --kind "$kind" --issuer firekeep-admin --dist-base "$dist_base")
    [ -n "$agent" ] && cmd+=(--agent "$agent")
    [ -n "$expires_days" ] && cmd+=(--expires-days "$expires_days")
    [ -n "$host" ] && cmd+=(--host "$host")
    [ -n "$base_url" ] && cmd+=(--base-url "$base_url")
    [ -n "$ssh_target" ] && cmd+=(--ssh-target "$ssh_target")
    [ -n "$ca_pem_b64" ] && cmd+=(--ca-pem-b64 "$ca_pem_b64")
    [ -n "$ca_mode" ] && cmd+=(--ca "$ca_mode")
    [ -n "$member" ] && cmd+=(--member-id "$member")
    # mint.py gates transport=http behind --insecure-http regardless of host, so
    # --local has to pass it. The gate is doing its job; loopback is the one case
    # where the answer to "is plain HTTP acceptable?" is unambiguously yes.
    { [ "$insecure" -eq 1 ] || [ "$local_only" -eq 1 ]; } && cmd+=(--insecure-http)
    [ "$output_json" -eq 1 ] && cmd+=(--json)
    if [ "${FIREKEEP_ADMIN_DRY_RUN:-0}" = "1" ]; then
        printf '%q ' "${cmd[@]}"; echo
        return
    fi
    "${cmd[@]}"
}

# Member removal/restore (docs/THREAT-MODEL.md §5.17). Runs the SAME Python
# implementation as DELETE /members/{id} (auth/members.py) inside cortex-api,
# like `invite` does for app.enroll.mint, rather than a bash port of the owner
# and last-admin rules and the credential/join-code sweep. Like `invite`, it
# needs docker compose; on the office Kubernetes deployment use the dashboard
# (Members -> Remove) or `kubectl exec` the same module.
members() {
    local sub="${1:-}" member_id=""
    case "$sub" in
        list) [ $# -eq 1 ] || usage ;;
        remove|restore)
            [ $# -eq 2 ] || usage
            member_id="$2"
            valid_member "$member_id" || { echo "ERROR: invalid member id" >&2; exit 1; }
            ;;
        *) usage ;;
    esac
    local cmd=(docker compose exec -T cortex-api python -m app.members.admin "$sub")
    [ -n "$member_id" ] && cmd+=("$member_id")
    if [ "${FIREKEEP_ADMIN_DRY_RUN:-0}" = "1" ]; then
        printf '%q ' "${cmd[@]}"; echo
        return
    fi
    "${cmd[@]}"
    if [ "$sub" = "restore" ]; then
        echo "Restored ${member_id}: it holds no credential yet. Issue its join code: firekeep-admin invite --member ${member_id}" >&2
    fi
}

valid_iso() { [[ "$1" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(:[0-9]{2}(\.[0-9]+)?)?(Z|[+-][0-9]{2}:[0-9]{2})$ ]]; }

# Revert by credential (docs/THREAT-MODEL.md §5.19). Calls POST
# /admin/memory/revert[/undo] on cortex-api -- the same selection and
# lifecycle the route tests cover -- rather than a bash port of it. The key
# travels in a header read from stdin, not on curl's command line.
memory_api() {  # $1=path  $2=json body
    if [ "${FIREKEEP_ADMIN_DRY_RUN:-0}" = "1" ]; then
        echo "POST ${API_URL}$1"
        echo "$2"
        return
    fi
    local key
    key="$(admin_api_key)"
    printf 'X-API-Key: %s\n' "$key" | curl -sS --fail-with-body -X POST "${API_URL}$1" \
        -H @- -H "Content-Type: application/json" -d "$2" \
        || { echo; echo "ERROR: POST $1 failed (an admin key is required)." >&2; exit 1; }
    echo
}

memory() {
    local sub="${1:-}"
    [ $# -gt 0 ] && shift
    local credential="" since="" until_ts="" revert_id="" apply=false body
    while [ $# -gt 0 ]; do
        case "$1" in
            --credential) credential="${2:?--credential requires a value}"; shift 2 ;;
            --since) since="${2:?--since requires a value}"; shift 2 ;;
            --until) until_ts="${2:?--until requires a value}"; shift 2 ;;
            --revert-id) revert_id="${2:?--revert-id requires a value}"; shift 2 ;;
            --apply) apply=true; shift ;;
            *) echo "Unknown argument: $1" >&2; usage ;;
        esac
    done
    case "$sub" in
        revert)
            valid_id "$credential" || { echo "ERROR: --credential must be a credential id (hex)" >&2; exit 1; }
            valid_iso "$since" || { echo "ERROR: --since must be ISO 8601 with a UTC offset, e.g. 2026-10-05T10:00:00+00:00" >&2; exit 1; }
            [ -z "$until_ts" ] || valid_iso "$until_ts" || { echo "ERROR: --until must be ISO 8601 with a UTC offset" >&2; exit 1; }
            body="{\"credential_id\": \"${credential}\", \"since\": \"${since}\""
            [ -n "$until_ts" ] && body="${body}, \"until\": \"${until_ts}\""
            body="${body}, \"apply\": ${apply}}"
            memory_api /admin/memory/revert "$body"
            if [ "$apply" = false ]; then
                echo "Dry run: nothing changed. Revoke the key first (keys revoke ${credential}), then re-run with --apply." >&2
            else
                echo "Undo with: firekeep-admin memory revert-undo --revert-id <revert_id above> --apply" >&2
            fi
            ;;
        revert-undo)
            [[ "$revert_id" =~ ^[0-9a-f]{32}$ ]] || { echo "ERROR: --revert-id must be the 32-hex revert_id a revert printed" >&2; exit 1; }
            memory_api /admin/memory/revert/undo "{\"revert_id\": \"${revert_id}\", \"apply\": ${apply}}"
            ;;
        *) usage ;;
    esac
}

admin_api_key() {
    local key="${FIREKEEP_ADMIN_KEY:-}"
    [ -n "$key" ] || key="$(env_get DASHBOARD_API_KEY)"
    if [ -z "$key" ]; then
        echo "ERROR: no FIREKEEP_ADMIN_KEY or DASHBOARD_API_KEY is available" >&2
        exit 1
    fi
    printf '%s' "$key"
}

case "${1:-}" in
    keys)
        case "${2:-}" in
            create) shift 2; keys_create "$@" ;;
            revoke) shift 2; keys_revoke "$@" ;;
            audit) shift 2; keys_audit "$@" ;;
            *) usage ;;
        esac
        ;;
    invite) shift; invite "$@" ;;
    members) shift; members "$@" ;;
    memory) shift; memory "$@" ;;
    *) usage ;;
esac
