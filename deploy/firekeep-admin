#!/usr/bin/env bash
set -euo pipefail

# firekeep-admin — thin curl wrapper for Firekeep admin operations (SP1a §4.3).
#
# Usage:
#   firekeep-admin keys create --agent <name> [--expires-days N]
#
# Environment:
#   FIREKEEP_ADMIN_KEY        admin API key (from bootstrap-keys.sh; prompted if unset)
#   FIREKEEP_API_URL          Cortex REST base URL (default: http://localhost:8100)
#   FIREKEEP_ADMIN_DRY_RUN=1  print the request instead of sending it (tests)

# The teammate scope set: every scope EXCEPT "admin". Deliberately NOT ["*"]
# — "*" passes require_scope("admin"), which would let every teammate read
# vault secrets and mint keys (spec §3). Only holds because cortex-mcp
# forwards the CALLER's key (§4.2 confused-deputy fix).
# MUST stay in sync with SCOPES in auth/middleware.py minus {"admin"}
# (post-SP1a table: eval:write added, twin:read removed) — the test
# deploy/tests/test_firekeep_admin.sh enforces this.
NON_ADMIN_SCOPES='["memory:read","memory:write","session:read","session:write","replay:read","relay:read","relay:write","eval:read","eval:write"]'

API_URL="${FIREKEEP_API_URL:-http://localhost:8100}"

usage() {
    cat >&2 <<'EOF'
Usage: firekeep-admin keys create --agent <name> [--expires-days N]

Issues a teammate API key with the full non-admin scope set.
Requires FIREKEEP_ADMIN_KEY (or interactive prompt) and a reachable Cortex API
(FIREKEEP_API_URL, default http://localhost:8100).
EOF
    exit 1
}

[ "${1:-}" = "keys" ] && [ "${2:-}" = "create" ] || usage
shift 2

AGENT=""
EXPIRES_DAYS=""
while [ $# -gt 0 ]; do
    case "$1" in
        --agent)        AGENT="${2:?--agent requires a value}"; shift 2 ;;
        --expires-days) EXPIRES_DAYS="${2:?--expires-days requires a value}"; shift 2 ;;
        *) echo "Unknown argument: $1" >&2; usage ;;
    esac
done
[ -n "$AGENT" ] || usage

BODY="{\"agent_id\": \"${AGENT}\", \"scopes\": ${NON_ADMIN_SCOPES}"
if [ -n "$EXPIRES_DAYS" ]; then
    BODY="${BODY}, \"expires_days\": ${EXPIRES_DAYS}"
fi
BODY="${BODY}}"

if [ "${FIREKEEP_ADMIN_DRY_RUN:-0}" = "1" ]; then
    echo "POST ${API_URL}/auth/keys"
    echo "$BODY"
    exit 0
fi

# --- LOCAL path: on the server, with no admin key ---------------------------
#
# The admin key is printed exactly once by bootstrap-keys.sh and deliberately
# never stored, so on any server that has been running a while it is simply gone
# -- and with it, the ability to onboard a teammate. That made this command
# unusable in the one situation it exists for. (Found live: onboarding the
# author's own second machine required writing the key into Redis by hand.)
#
# Resolution: when no admin key is available AND Redis DB 7 is reachable, mint
# directly, exactly as deploy/bootstrap-keys.sh already does. This is not a
# weakening. Reaching Redis here means a shell on the server, which already
# implies total control -- `docker exec redis-cli` can mint a key with or
# without this script. Requiring an unrecoverable HTTP credential on top bought
# no security, only an onboarding dead end.
#
# The HTTP path below remains for genuine REMOTE administration, where the admin
# key IS the authorization.
IFS=' ' read -r -a REDIS <<< "${BOOTSTRAP_REDIS_CMD:-docker compose exec -T redis redis-cli -n 7}"

mint_local() {
    local key hash now
    key="fk_$(openssl rand -hex 24)"
    hash="$(printf '%s' "$key" | sha256sum | awk '{print $1}')"
    now="$(date -u +"%Y-%m-%dT%H:%M:%S+00:00")"
    "${REDIS[@]}" HSET "auth:key:${hash}" \
        agent_id "$AGENT" scopes "$NON_ADMIN_SCOPES" created_at "$now" \
        key_id "${hash:0:16}" >/dev/null
    if [ -n "$EXPIRES_DAYS" ]; then
        "${REDIS[@]}" HSET "auth:key:${hash}" \
            expires_at "$(date -u -d "+${EXPIRES_DAYS} days" +"%Y-%m-%dT%H:%M:%S+00:00")" >/dev/null
    fi
    "${REDIS[@]}" ZADD auth:key_index "$(date -u +%s)" "${hash:0:16}" >/dev/null
    printf '{"agent_id": "%s", "key_id": "%s", "api_key": "%s"}\n' \
        "$AGENT" "${hash:0:16}" "$key"
}

if [ -z "${FIREKEEP_ADMIN_KEY:-}" ]; then
    if "${REDIS[@]}" PING 2>/dev/null | grep -q PONG; then
        mint_local
        echo "" >&2
        echo "Minted locally against Redis DB 7 (no admin key needed on the server)." >&2
        echo "Send the api_key above to ${AGENT} out-of-band -- it is shown only once." >&2
        exit 0
    fi
    # Only prompt when a human can actually answer. Previously this called
    # `read` unconditionally, so under BatchMode/CI it blocked until the caller
    # timed out with no diagnosis at all.
    if [ ! -t 0 ]; then
        echo "ERROR: no FIREKEEP_ADMIN_KEY, no TTY to prompt, and Redis DB 7 is unreachable." >&2
        echo "  On the server: run this from the compose project dir (it mints locally)." >&2
        echo "  Remotely:      set FIREKEEP_ADMIN_KEY, or override BOOTSTRAP_REDIS_CMD." >&2
        exit 1
    fi
    read -rsp "Admin API key: " FIREKEEP_ADMIN_KEY
    echo
fi

# --- REMOTE path: admin key supplied ----------------------------------------
RESPONSE="$(curl -sf -X POST "${API_URL}/auth/keys" \
    -H "Content-Type: application/json" \
    -H "X-API-Key: ${FIREKEEP_ADMIN_KEY}" \
    -d "$BODY")" || {
    echo "ERROR: key creation failed." >&2
    echo "  Check: FIREKEEP_ADMIN_KEY is the bootstrap admin key, AUTH_ENABLED" >&2
    echo "  is consistent on the server, and ${API_URL} is reachable." >&2
    exit 1
}

echo "$RESPONSE"
echo ""
echo "Send the api_key above to ${AGENT} out-of-band (it is shown only once)." >&2
