# OpenAI Secure MCP Tunnel -> firekeep gateway (chat toolset).
# Install per README.md in this directory. The tunnel makes OUTBOUND-only
# HTTPS to OpenAI's control plane; the Keep stays tailnet-private — no inbound
# port opens anywhere.
[Unit]
Description=Firekeep ChatGPT tunnel (Secure MCP Tunnel -> firekeep gateway)
After=network-online.target
Wants=network-online.target

[Service]
# WorkingDirectory holds ./profiles/firekeep.yaml (created by tunnel-client init).
WorkingDirectory=/etc/firekeep/chatgpt-tunnel
# tunnel.env (0600 root:root) holds CONTROL_PLANE_API_KEY. Deliberately NOT in
# Firekeep's vault: the tunnel must start before the Keep's own auth matters,
# and the vault lives inside the thing being exposed.
EnvironmentFile=/etc/firekeep/chatgpt-tunnel/tunnel.env
ExecStart=/usr/local/bin/tunnel-client run --profile firekeep
# Restart=always is also the long-lived-gateway backstop: restarting
# tunnel-client restarts the spawned gateway and its backend shims.
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
